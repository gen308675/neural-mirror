<!-- FRONTEND INTERACTION SCRIPT -->
<script>
  const drawer = document.getElementById("drawer");
  const drawerOverlay = document.getElementById("drawer-overlay");
  const toggleBtn = document.getElementById("toggle-drawer");
  const closeDrawerBtn = document.getElementById("close-drawer-btn");
  const backdrop = document.getElementById("modal-backdrop");
  const form = document.getElementById("chat-form") as HTMLFormElement;
  const input = document.getElementById("chat-input") as HTMLInputElement;
  const output = document.getElementById("chat-output") as HTMLDivElement;
  const idleHero = document.getElementById("idle-hero");

  // Map trigger tags to public video paths
  const projectVideos: Record<string, string> = {
    "[TRIGGER:P1]": "/videos/p1-digest.mp4",
    "[TRIGGER:P2]": "/videos/p2-lead-enrichment.mp4",
    "[TRIGGER:P3]": "/videos/p3-support.mp4",
    "[TRIGGER:P4]": "/videos/p4-rag.mp4",
    "[TRIGGER:P5]": "/videos/p5-orders.mp4",
  };

  let conversationHistory: {
    role: "user" | "assistant";
    content: string;
  }[] = [];

  // State & Timeout Tracking
  let modalTimeout: number | undefined;

  // Smooth Drawer & Overlay Handlers
  function openDrawer() {
    if (!drawer) return;
    drawer.classList.remove("-translate-x-full");

    if (drawerOverlay) {
      drawerOverlay.classList.remove("hidden");
      requestAnimationFrame(() => {
        drawerOverlay.classList.remove("opacity-0");
        drawerOverlay.classList.add("opacity-100");
      });
    }
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.add("-translate-x-full");

    if (drawerOverlay) {
      drawerOverlay.classList.remove("opacity-100");
      drawerOverlay.classList.add("opacity-0");
      setTimeout(() => drawerOverlay.classList.add("hidden"), 300);
    }
  }

  function toggleDrawer() {
    if (!drawer) return;
    const isClosed = drawer.classList.contains("-translate-x-full");
    if (isClosed) {
      openDrawer();
    } else {
      closeDrawer();
    }
  }

  // Drawer Event Listeners
  toggleBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    toggleDrawer();
  });

  closeDrawerBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    closeDrawer();
  });

  // Auto-close drawer when clicking on the blurred chat screen overlay
  drawerOverlay?.addEventListener("click", () => {
    closeDrawer();
  });

  // Timer-Safe Modal Handlers
  function openModal(id: string) {
    const targetModal = document.getElementById(id);
    if (!targetModal || !backdrop) return;

    if (modalTimeout) clearTimeout(modalTimeout);

    document.querySelectorAll(".modal-window").forEach((m) => {
      if (m !== targetModal) {
        m.classList.add("hidden", "opacity-0", "scale-95");
        m.classList.remove("opacity-100", "scale-100");
      }
    });

    backdrop.classList.remove("hidden");
    targetModal.classList.remove("hidden");

    requestAnimationFrame(() => {
      backdrop.classList.remove("opacity-0");
      backdrop.classList.add("opacity-100");
      targetModal.classList.remove("opacity-0", "scale-95");
      targetModal.classList.add("opacity-100", "scale-100");
    });
  }

  function closeAllModals() {
    document.querySelectorAll(".modal-window").forEach((m) => {
      m.classList.remove("opacity-100", "scale-100");
      m.classList.add("opacity-0", "scale-95");
    });

    if (backdrop) {
      backdrop.classList.remove("opacity-100");
      backdrop.classList.add("opacity-0");
    }

    if (modalTimeout) clearTimeout(modalTimeout);
    modalTimeout = window.setTimeout(() => {
      document
        .querySelectorAll(".modal-window")
        .forEach((m) => m.classList.add("hidden"));
      backdrop?.classList.add("hidden");
    }, 200);
  }

  // Handle Drawer Item Clicks
  document.querySelectorAll("[data-modal]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();

      const modalId = btn.getAttribute("data-modal");
      if (modalId) {
        openModal(modalId);
        closeDrawer();
      }
    });
  });

  // Close modal buttons
  document.querySelectorAll(".close-modal").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      closeAllModals();
    });
  });

  // Modal Backdrop click closes both
  backdrop?.addEventListener("click", () => {
    closeAllModals();
    closeDrawer();
  });

  async function handleSendMessage(query: string) {
    if (!query) return;

    // 1. Remove Centered Hero on first message
    if (idleHero) {
      idleHero.remove();
    }

    // 2. Render User Query
    output.innerHTML += `
    <div class="flex justify-end">
      <div class="bg-teal-600/20 border border-teal-500/30 text-teal-200 text-xs p-3 rounded-2xl max-w-xl">
        ${query}
      </div>
    </div>
  `;

    conversationHistory.push({ role: "user", content: query });
    if (input) input.value = "";
    output.scrollTop = output.scrollHeight;

    // 3. Render Thinking State Bubble
    const responseBubble = document.createElement("div");
    responseBubble.className = "flex justify-start";
    responseBubble.innerHTML = `
    <div class="bg-slate-900 border border-slate-800 text-slate-300 text-xs p-3.5 rounded-2xl max-w-xl animate-pulse">
      Neural Mirror thinking...
    </div>
  `;
    output.appendChild(responseBubble);
    output.scrollTop = output.scrollHeight;

    // 4. Stream Assistant Response from API
    try {
      const response = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: conversationHistory }),
      });

      // CATCH BACKEND HTTP ERRORS BEFORE STREAMING
      if (!response.ok) {
        conversationHistory.pop(); // Remove failed prompt from memory

        if (response.status === 429) {
          responseBubble.innerHTML = `
          <div class="bg-amber-950/40 border border-amber-800/60 text-amber-300 text-xs p-3.5 rounded-2xl max-w-xl leading-relaxed">
            <strong>Quota Limit Reached:</strong> Gemini API rate limit hit. Please wait ~30 seconds before sending another message.
          </div>
        `;
        } else if (response.status === 503) {
          // 🔴 HANDLE 503 HIGH DEMAND ERROR
          responseBubble.innerHTML = `
          <div class="bg-blue-950/40 border border-blue-800/60 text-blue-300 text-xs p-3.5 rounded-2xl max-w-xl leading-relaxed">
          <strong>Model Overloaded:</strong> Google servers are currently experiencing high demand. Please wait a few seconds and try sending your message again.
          </div>
        `;
        } else {
          responseBubble.innerHTML = `
          <div class="bg-red-950/40 border border-red-800/60 text-red-300 text-xs p-3.5 rounded-2xl max-w-xl leading-relaxed">
            Service error (${response.status}). Please try again in a moment.
          </div>
        `;
        }
        output.scrollTop = output.scrollHeight;
        return;
      }

      if (!response.body) {
        throw new Error("Empty response body received");
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder("utf-8");
      let assistantResponse = "";

      while (true) {
        const { value, done } = await reader.read();
        if (done) break;

        const textChunk = decoder.decode(value, { stream: true });
        assistantResponse += textChunk;

        // Check if stream returned JSON error string instead of text (e.g. rate limit inside stream)
        if (
          assistantResponse.includes('"error"') &&
          (assistantResponse.includes("429") ||
            assistantResponse.includes("quota") ||
            assistantResponse.includes("RESOURCE_EXHAUSTED"))
        ) {
          conversationHistory.pop();
          responseBubble.innerHTML = `
          <div class="bg-amber-950/40 border border-amber-800/60 text-amber-300 text-xs p-3.5 rounded-2xl max-w-xl leading-relaxed">
            <strong>Quota Limit Reached:</strong> Rate limit reached during streaming. Please wait ~30 seconds and retry.
          </div>
        `;
          output.scrollTop = output.scrollHeight;
          return;
        }

        // Detect inline project video trigger tag
        const detectedTag = Object.keys(projectVideos).find((tag) =>
          assistantResponse.includes(tag),
        );

        let videoEmbedHtml = "";
        if (detectedTag && projectVideos[detectedTag]) {
          videoEmbedHtml = `
          <div class="mt-3 rounded-xl overflow-hidden border border-slate-800 bg-slate-950 aspect-video w-full shadow-lg">
            <video controls class="w-full h-full object-cover">
              <source src="${projectVideos[detectedTag]}" type="video/mp4" />
              Your browser does not support playing this video.
            </video>
          </div>
        `;
        }

        // Clean trigger tags out of visible text
        let visibleText = assistantResponse
          .replace(/\[TRIGGER:P[1-5]\]/g, "")
          .replace(/\[TRIGGER:PROFILE\]/g, "")
          .replace(/\[TRIGGER:CONTACT\]/g, "")
          .replace(/\*\*/g, "") // Removes double asterisks (bold)
          .replace(/^\s*\*\s+/gm, "• "); // Converts asterisk bullet points into clean bullet dots

        responseBubble.innerHTML = `
        <div class="bg-slate-900 border border-slate-800 text-slate-300 text-xs p-3.5 rounded-2xl max-w-xl leading-relaxed">
          <div>${visibleText}</div>
          ${videoEmbedHtml}
        </div>
      `;
        output.scrollTop = output.scrollHeight;
      }

      conversationHistory.push({
        role: "assistant",
        content: assistantResponse,
      });
    } catch (err) {
      console.error("Chat error:", err);

      // Safety check: remove failed user prompt if conversation history got desynced
      if (
        conversationHistory.length > 0 &&
        conversationHistory[conversationHistory.length - 1].role === "user"
      ) {
        conversationHistory.pop();
      }

      responseBubble.innerHTML = `
      <div class="bg-red-950/40 border border-red-800/60 text-red-300 text-xs p-3.5 rounded-2xl max-w-xl leading-relaxed">
        Connection lost or server offline. Please retry.
      </div>
    `;
      output.scrollTop = output.scrollHeight;
    }
  }

  // Chat Stream Form Submission
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const query = input.value.trim();
    handleSendMessage(query);
  });

  // Starter Chips Click Event Listeners
  document.querySelectorAll(".chip-btn").forEach((chip) => {
    chip.addEventListener("click", () => {
      const chipQuery = chip.textContent?.trim();
      if (chipQuery) {
        handleSendMessage(chipQuery);
      }
    });
  });
</script>

