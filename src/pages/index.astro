    <script>
      import { gsap } from "gsap";

      const form = document.getElementById("chat-form") as HTMLFormElement;
      const input = document.getElementById("chat-input") as HTMLInputElement;
      const output = document.getElementById("chat-output") as HTMLDivElement;

      // UI Component Registry for Presentation Canvas Transitions
      const standbyScreen = document.getElementById("canvas-standby");
      const viewICare = document.getElementById("view-icare");
      const viewBlueTeam = document.getElementById("view-blue-team");
      const viewAgentFlow = document.getElementById("view-agent-flow");
      const viewContact = document.getElementById("view-contact");

      // Tree Node Indicators for left side terminal feedback
      const node1 = document.getElementById("node-01");
      const node2 = document.getElementById("node-02");
      const node3 = document.getElementById("node-03");

      let activeView: HTMLElement | null = null;
      let conversationHistory: {
        role: "user" | "assistant";
        content: string;
      }[] = [];

      // Unified Dynamic Canvas State Engine
      function switchCanvasView(
        targetView: HTMLElement | null,
        activeNode: HTMLElement | null = null,
      ) {
        // Reset tree node color highlighting
        [node1, node2, node3].forEach((n) =>
          n?.classList.remove(
            "text-cyan-400",
            "text-red-400",
            "text-emerald-400",
          ),
        );

        // Highlight target node using specific identity colors if mapped
        if (activeNode) {
          if (activeNode === node1) activeNode.classList.add("text-cyan-400");
          if (activeNode === node2) activeNode.classList.add("text-cyan-400");
          if (activeNode === node3)
            activeNode.classList.add("text-cyan-400");
        }

        if (activeView === targetView) return;

        const viewsToFadeOut = activeView ? [activeView] : [standbyScreen];

        gsap.to(viewsToFadeOut, {
          opacity: 0,
          duration: 0.25,
          onComplete: () => {
            viewsToFadeOut.forEach((v) => {
              if (v) v.style.display = "none";
            });

            const nextView = targetView ? targetView : standbyScreen;
            if (nextView) {
              // FIX: Set a standard browser-readable display value ("block" or "flex")
              nextView.style.display = "block";
              gsap.to(nextView, { opacity: 1, duration: 0.35 });
            }
            activeView = targetView;
          },
        });
      }

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const query = input.value.trim();
        if (!query) return;

        // Append user text token array inside console output box
        output.innerHTML += `<div class="mt-2 text-[#00ff00]/40 font-bold">&gt; ${query}</div>`;
        conversationHistory.push({ role: "user", content: query });
        input.value = "";

        // 1. SNAP ONCE HERE: Make immediate layout room for user feedback
        output.scrollTop = output.scrollHeight;

        // Create the response container element
        const responseBubble = document.createElement("div");
        responseBubble.className =
          "mt-1 leading-relaxed transition-all duration-300";
        output.appendChild(responseBubble);

        // 2. INJECT BULLET LOADER: Show a pulsing medical teal indicator inside the response container
        responseBubble.innerHTML = `
          <div id="stream-loader" class="flex items-center gap-2 text-[#0ea5a8] font-mono text-xs my-2 animate-pulse">
            <span class="w-2 h-2 bg-[#0ea5a8] rounded-full animate-ping"></span>
            <span>...</span>
          </div>
        `;

        // 3. SMART ANCHOR SNAP: Smoothly align the top of the response bubble into view
        responseBubble.scrollIntoView({ behavior: "smooth", block: "start" });

        try {
          const response = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ messages: conversationHistory }),
          });

          if (!response.body) return;
          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let assistantResponse = "";
          let hasSnappedOnceOnContent = false;

          while (true) {
            const { value, done } = await reader.read();
            if (done) break;

            const textChunk = decoder.decode(value);
            assistantResponse += textChunk;

            // Continuous Real-Time Interception of Contextual Steering Trigger Tags
            if (assistantResponse.includes("[TRIGGER:ICARE]")) {
              switchCanvasView(viewICare, node1);
            } else if (assistantResponse.includes("[TRIGGER:BLUE-TEAM]")) {
              switchCanvasView(viewBlueTeam, node2);
            } else if (assistantResponse.includes("[TRIGGER:AGENT-FLOW]")) {
              switchCanvasView(viewAgentFlow, node3);
            } else if (assistantResponse.includes("[TRIGGER:CONTACT]")) {
              switchCanvasView(viewContact);
            } else if (assistantResponse.includes("[TRIGGER:RESET]")) {
              switchCanvasView(null);
            }

            // Strip structural execution tags out so they stay invisible to the browser visitor
            let visibleText = assistantResponse
              .replace("[TRIGGER:ICARE]", "")
              .replace("[TRIGGER:BLUE-TEAM]", "")
              .replace("[TRIGGER:AGENT-FLOW]", "")
              .replace("[TRIGGER:CONTACT]", "")
              .replace("[TRIGGER:RESET]", "");

            // 4. OVERWRITE LOADER: The moment actual text tokens land, the innerText clears out the bullet loader
            responseBubble.innerText =
              visibleText || "Synchronizing telemetry matrices...";

            // 5. FIRST PARAGRAPH LOCK: Snaps one precise frame onto the first few characters
            // of real content to keep the text visible, then locks so it won't scroll automatically anymore.
            if (!hasSnappedOnceOnContent && visibleText.length > 5) {
              responseBubble.scrollIntoView({
                behavior: "auto",
                block: "start",
              });
              hasSnappedOnceOnContent = true;
            }
          }

          conversationHistory.push({
            role: "assistant",
            content: assistantResponse,
          });
        } catch (err) {
          responseBubble.innerHTML = `<span class="text-red-500 font-bold">[PIPELINE_FAULT] Failed to compile server stream data.</span>`;
        }
      });
    </script>

