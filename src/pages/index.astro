<script>
  import { marked } from "marked";

  // Configure marked for clean breaks and GFM parsing
  marked.setOptions({
    breaks: true,
    gfm: true,
  });

  const drawer = document.getElementById("drawer");
  const drawerOverlay = document.getElementById("drawer-overlay");
  const toggleBtn = document.getElementById("toggle-drawer");
  const closeDrawerBtn = document.getElementById("close-drawer-btn");
  const backdrop = document.getElementById("modal-backdrop");
  const form = document.getElementById("chat-form") as HTMLFormElement;
  const input = document.getElementById("chat-input") as HTMLInputElement;
  const output = document.getElementById("chat-output") as HTMLDivElement;
  const idleHero = document.getElementById("idle-hero");

  let conversationHistory: { role: "user" | "assistant"; content: string }[] =
    [];
  let modalTimeout: number | undefined;

  function openDrawer() {
    if (!drawer) return;
    drawer.classList.remove("-translate-x-full");
    if (drawerOverlay) {
      drawerOverlay.classList.remove("hidden");
      requestAnimationFrame(() => {
        drawerOverlay.classList.remove("opacity-0");
        drawerOverlay.classList.add("opacity-100");
      });
    }
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.add("-translate-x-full");
    if (drawerOverlay) {
      drawerOverlay.classList.remove("opacity-100");
      drawerOverlay.classList.add("opacity-0");
      setTimeout(() => drawerOverlay.classList.add("hidden"), 300);
    }
  }

  toggleBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    drawer?.classList.contains("-translate-x-full")
      ? openDrawer()
      : closeDrawer();
  });

  closeDrawerBtn?.addEventListener("click", closeDrawer);
  drawerOverlay?.addEventListener("click", closeDrawer);

  function openModal(id: string) {
    const targetModal = document.getElementById(id);
    if (!targetModal || !backdrop) return;
    if (modalTimeout) clearTimeout(modalTimeout);

    document.querySelectorAll(".modal-window").forEach((m) => {
      if (m !== targetModal) m.classList.add("hidden", "opacity-0", "scale-95");
    });

    backdrop.classList.remove("hidden");
    targetModal.classList.remove("hidden");

    requestAnimationFrame(() => {
      backdrop.classList.remove("opacity-0");
      backdrop.classList.add("opacity-100");
      targetModal.classList.remove("opacity-0", "scale-95");
      targetModal.classList.add("opacity-100", "scale-100");
    });
  }

  function closeAllModals() {
    document.querySelectorAll(".modal-window").forEach((m) => {
      m.classList.remove("opacity-100", "scale-100");
      m.classList.add("opacity-0", "scale-95");
    });
    if (backdrop) backdrop.classList.add("opacity-0");

    if (modalTimeout) clearTimeout(modalTimeout);
    modalTimeout = window.setTimeout(() => {
      document
        .querySelectorAll(".modal-window")
        .forEach((m) => m.classList.add("hidden"));
      backdrop?.classList.add("hidden");
    }, 200);
  }

  document.querySelectorAll("[data-modal]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      const modalId = btn.getAttribute("data-modal");
      if (modalId) {
        openModal(modalId);
        closeDrawer();
      }
    });
  });

  document
    .querySelectorAll(".close-modal")
    .forEach((btn) => btn.addEventListener("click", closeAllModals));
  backdrop?.addEventListener("click", closeAllModals);
  // --- WORKFLOW 02: MODAL TAB SWITCHER ---
  const tabBtnTester = document.getElementById("tab-btn-tester");
  const tabBtnVideo = document.getElementById("tab-btn-video");
  const tabContentTester = document.getElementById("tab-content-tester");
  const tabContentVideo = document.getElementById("tab-content-video");

  tabBtnTester?.addEventListener("click", () => {
    // Show Tester Panel, Hide Video Panel
    tabContentTester?.classList.remove("hidden");
    tabContentVideo?.classList.add("hidden");

    // Active Style for Tester Tab
    tabBtnTester.className =
      "flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-semibold rounded-lg bg-teal-500/10 text-teal-400 border border-teal-500/30 transition-all";

    // Inactive Style for Video Tab
    if (tabBtnVideo) {
      tabBtnVideo.className =
        "flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-medium rounded-lg text-slate-400 hover:text-slate-200 border border-transparent transition-all";
    }
  });

  tabBtnVideo?.addEventListener("click", () => {
    // Show Video Panel, Hide Tester Panel
    tabContentVideo?.classList.remove("hidden");
    tabContentTester?.classList.add("hidden");

    // Active Style for Video Tab
    tabBtnVideo.className =
      "flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-semibold rounded-lg bg-teal-500/10 text-teal-400 border border-teal-500/30 transition-all";

    // Inactive Style for Tester Tab
    if (tabBtnTester) {
      tabBtnTester.className =
        "flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-medium rounded-lg text-slate-400 hover:text-slate-200 border border-transparent transition-all";
    }
  });

  // --- WORKFLOW 03: MODAL TAB SWITCHER ---
  const p3TabBtnTester = document.getElementById("p3-tab-btn-tester");
  const p3TabBtnVideo = document.getElementById("p3-tab-btn-video");
  const p3TabContentTester = document.getElementById("p3-tab-content-tester");
  const p3TabContentVideo = document.getElementById("p3-tab-content-video");

  p3TabBtnTester?.addEventListener("click", () => {
    p3TabContentTester?.classList.remove("hidden");
    p3TabContentVideo?.classList.add("hidden");

    p3TabBtnTester.className =
      "flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-semibold rounded-lg bg-teal-500/10 text-teal-400 border border-teal-500/30 transition-all";
    if (p3TabBtnVideo) {
      p3TabBtnVideo.className =
        "flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-medium rounded-lg text-slate-400 hover:text-slate-200 border border-transparent transition-all";
    }
  });

  p3TabBtnVideo?.addEventListener("click", () => {
    p3TabContentVideo?.classList.remove("hidden");
    p3TabContentTester?.classList.add("hidden");

    p3TabBtnVideo.className =
      "flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-semibold rounded-lg bg-teal-500/10 text-teal-400 border border-teal-500/30 transition-all";
    if (p3TabBtnTester) {
      p3TabBtnTester.className =
        "flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-medium rounded-lg text-slate-400 hover:text-slate-200 border border-transparent transition-all";
    }
  });

  // Add this helper object at the top of your frontend script
  // Ensure VIDEO_EMBEDS includes [TRIGGER:P0]
  const VIDEO_EMBEDS: Record<string, { title: string; id: string }> = {
    "[TRIGGER:P0]": { title: "About Me & Tech Stack", id: "4rffE0kndow" },
    "[TRIGGER:P1]": { title: "Workflow 01 Walkthrough", id: "579NnUSjCHc" },
    "[TRIGGER:P2]": { title: "Workflow 02 Walkthrough", id: "qcQq_wjTRIs" },
    "[TRIGGER:P3]": { title: "Workflow 03 Walkthrough", id: "mw14B0SoXgM" },
  };

async function handleSendMessage(query: string) {
  if (!query) return;

  if (idleHero) idleHero.remove();

  output.innerHTML += `
  <div class="flex justify-end mb-3">
    <div class="bg-teal-600/20 border border-teal-500/30 text-teal-200 text-xs p-3 rounded-2xl max-w-xl">
      ${query}
    </div>
  </div>
`;

  conversationHistory.push({ role: "user", content: query });
  if (input) input.value = "";
  output.scrollTop = output.scrollHeight;

  const responseBubble = document.createElement("div");
  responseBubble.className = "flex justify-start mb-3";
  responseBubble.innerHTML = `
  <div class="bg-slate-900 border border-slate-800 text-slate-300 text-xs p-3.5 rounded-2xl max-w-xl animate-pulse">
    Neural Mirror thinking...
  </div>
`;
  output.appendChild(responseBubble);
  output.scrollTop = output.scrollHeight;

  try {
    const response = await fetch("/api/chat", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ messages: conversationHistory }),
    });

    if (!response.ok) {
      conversationHistory.pop();
      responseBubble.innerHTML = `<div class="text-xs text-red-400 p-3">Server response error (${response.status}).</div>`;
      return;
    }

    const data = await response.json();

    // Extract message content safely across n8n response shapes
    let assistantResponse = "";
    if (Array.isArray(data) && data[0]?.output) {
      assistantResponse = data[0].output;
    } else if (data.output) {
      assistantResponse = data.output;
    } else if (data.response) {
      assistantResponse = data.response;
    } else if (typeof data === "string") {
      assistantResponse = data;
    }

    if (!assistantResponse) {
      responseBubble.innerHTML = `<div class="text-xs text-red-400 p-3">Received empty response from agent.</div>`;
      return;
    }

    let processedText = assistantResponse;

    // Process YouTube video trigger embeds
    for (const [trigger, video] of Object.entries(VIDEO_EMBEDS)) {
      const regex = new RegExp(
        trigger.replace(/\[/g, "\\[").replace(/\]/g, "\\]"),
        "gi"
      );

      if (regex.test(processedText)) {
        const iframeHtml = `\n\n<div class="my-3 rounded-xl overflow-hidden border border-slate-700/60 aspect-video w-full bg-black shadow-lg"><iframe class="w-full h-full" src="https://www.youtube.com/embed/${video.id}?rel=0&modestbranding=1" title="${video.title}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>\n\n`;
        processedText = processedText.replace(regex, iframeHtml);
      }
    }

    const formattedHtml = await marked.parse(processedText);

    responseBubble.innerHTML = `
      <div class="bg-slate-900 border border-slate-800 text-slate-300 text-xs p-3.5 rounded-2xl w-full max-w-xl leading-relaxed markdown-content">
        ${formattedHtml}
      </div>
    `;
    output.scrollTop = output.scrollHeight;

    // Save final complete message to conversation history
    conversationHistory.push({
      role: "assistant",
      content: assistantResponse,
    });
  } catch (err) {
    console.error("Chat Error:", err);
    responseBubble.innerHTML = `<div class="text-xs text-red-400 p-3">Connection failed.</div>`;
  }
}

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    handleSendMessage(input.value.trim());
  });

  document.querySelectorAll(".chip-btn").forEach((chip) => {
    chip.addEventListener("click", () =>
      handleSendMessage(chip.textContent?.trim() || ""),
    );
  });

  // --- WORKFLOW 02: LIVE VOICE RECORDER & CONFIRMATION CONTROLLER ---
  const recordBtn = document.getElementById("record-btn");
  const recordBtnText = document.getElementById("record-btn-text");
  const recordDot = document.getElementById("record-dot");
  const recordStatus = document.getElementById("record-status");
  const audioPreview = document.getElementById(
    "audio-preview",
  ) as HTMLAudioElement;
  const sendVoiceBtn = document.getElementById(
    "send-voice-btn",
  ) as HTMLButtonElement;
  const voiceOutput = document.getElementById("voice-output");

  const contactConfirmCard = document.getElementById("contact-confirm-card");
  const confirmNameInput = document.getElementById(
    "confirm-name",
  ) as HTMLInputElement;
  const confirmEmailInput = document.getElementById(
    "confirm-email",
  ) as HTMLInputElement;
  const confirmSubmitBtn = document.getElementById(
    "confirm-submit-btn",
  ) as HTMLButtonElement;

  let mediaRecorder: MediaRecorder | null = null;
  let audioChunks: Blob[] = [];
  let recordedAudioBlob: Blob | null = null;
  let recordingInterval: number | undefined;
  let secondsRecorded = 0;
  let parsedPayload: any = null;

  // Status message state handler
  function setVoiceOutput(
    message: string,
    state: "info" | "warning" | "success" | "error",
  ) {
    if (!voiceOutput) return;
    voiceOutput.classList.remove("hidden");
    voiceOutput.textContent = message;

    switch (state) {
      case "info":
        voiceOutput.className =
          "mt-3 text-[11px] font-mono p-3 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 whitespace-pre-wrap";
        break;
      case "warning":
        voiceOutput.className =
          "mt-3 text-[11px] font-mono p-3 rounded-lg bg-amber-950/40 border border-amber-500/30 text-amber-300 whitespace-pre-wrap";
        break;
      case "success":
        voiceOutput.className =
          "mt-3 text-[11px] font-mono p-3 rounded-lg bg-emerald-950/40 border border-emerald-500/30 text-emerald-300 whitespace-pre-wrap";
        break;
      case "error":
        voiceOutput.className =
          "mt-3 text-[11px] font-mono p-3 rounded-lg bg-rose-950/40 border border-rose-500/30 text-rose-300 whitespace-pre-wrap";
        break;
    }
  }

  // Record Button Toggle Logic
  recordBtn?.addEventListener("click", async () => {
    if (!mediaRecorder || mediaRecorder.state === "inactive") {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          audio: true,
        });
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = [];

        mediaRecorder.ondataavailable = (e) => {
          if (e.data.size > 0) audioChunks.push(e.data);
        };

        mediaRecorder.onstop = () => {
          recordedAudioBlob = new Blob(audioChunks, { type: "audio/webm" });
          const audioUrl = URL.createObjectURL(recordedAudioBlob);

          if (audioPreview) {
            audioPreview.src = audioUrl;
            audioPreview.classList.remove("hidden");
          }

          if (sendVoiceBtn) sendVoiceBtn.disabled = false;
          if (recordStatus)
            recordStatus.textContent = `✓ Recording ready (${secondsRecorded}s)`;

          stream.getTracks().forEach((track) => track.stop());
        };

        mediaRecorder.start();
        secondsRecorded = 0;

        recordBtn.classList.replace("bg-teal-600", "bg-red-600");
        recordBtn.classList.replace("hover:bg-teal-500", "hover:bg-red-500");
        if (recordBtnText) recordBtnText.textContent = "Stop Recording";
        if (recordDot) recordDot.classList.add("animate-ping");

        recordingInterval = window.setInterval(() => {
          secondsRecorded++;
          if (recordStatus) {
            recordStatus.textContent = `🔴 Recording... 00:${secondsRecorded < 10 ? "0" : ""}${secondsRecorded}`;
          }
        }, 1000);
      } catch (err) {
        if (recordStatus)
          recordStatus.textContent = "Microphone access denied or unreadable.";
      }
    } else {
      mediaRecorder.stop();
      if (recordingInterval) clearInterval(recordingInterval);

      recordBtn.classList.replace("bg-red-600", "bg-teal-600");
      recordBtn.classList.replace("hover:bg-red-500", "hover:bg-teal-500");
      if (recordBtnText) recordBtnText.textContent = "Record Again";
      if (recordDot) recordDot.classList.remove("animate-ping");
    }
  });

  // STEP 1: Process Audio Note via n8n and Extract Details
  sendVoiceBtn?.addEventListener("click", async () => {
    if (!recordedAudioBlob) return;

    sendVoiceBtn.disabled = true;
    sendVoiceBtn.textContent = "Transmitting...";
    contactConfirmCard?.classList.add("hidden");
    setVoiceOutput(
      "⏳ Transcribing audio and extracting contact details with Gemini...",
      "info",
    );

    const formData = new FormData();
    formData.append("data", recordedAudioBlob, "voice-note.webm");

    try {
      const response = await fetch(
        "https://api.genmarkangus.dev/webhook/voice-transcriber",
        {
          method: "POST",
          body: formData,
        },
      );

      if (response.ok) {
        parsedPayload = await response.json();

        // Populate contact inputs with AI extractions or empty fallback
        if (confirmNameInput)
          confirmNameInput.value = parsedPayload.extracted_name || "";
        if (confirmEmailInput)
          confirmEmailInput.value = parsedPayload.extracted_email || "";

        if (
          parsedPayload.status === "missing_contact" ||
          !parsedPayload.has_valid_contact
        ) {
          setVoiceOutput(
            "⚠️ Note received, but we couldn't detect clear contact details. Please verify or enter your name and email below so I can respond!",
            "warning",
          );
        } else {
          setVoiceOutput(
            "✓ Audio transcribed successfully! Please verify your contact details below.",
            "info",
          );
        }

        // Display Step 2 confirmation form
        contactConfirmCard?.classList.remove("hidden");
      } else {
        setVoiceOutput(
          `⚠️ Processing failed with status code: ${response.status}`,
          "error",
        );
      }
    } catch (err) {
      setVoiceOutput(
        "❌ Connection failed. Check if the n8n container is running.",
        "error",
      );
    } finally {
      sendVoiceBtn.disabled = false;
      sendVoiceBtn.textContent = "Process Audio Note via n8n";
    }
  });

  // STEP 2: Confirm Verified/Edited Contact Info and Dispatch Gmail Alert
  confirmSubmitBtn?.addEventListener("click", async () => {
    const finalEmail = confirmEmailInput?.value.trim();
    const finalName = confirmNameInput?.value.trim() || "Anonymous Visitor";

    if (!finalEmail) {
      setVoiceOutput(
        "⚠️ Please enter a valid email address before submitting.",
        "warning",
      );
      return;
    }

    confirmSubmitBtn.disabled = true;
    confirmSubmitBtn.textContent = "Dispatching...";

    const finalPayload = {
      ...parsedPayload,
      sender_name: finalName,
      sender_email: finalEmail,
    };

    try {
      const response = await fetch(
        "https://api.genmarkangus.dev/webhook/voice-dispatch",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(finalPayload),
        },
      );

      if (response.ok) {
        contactConfirmCard?.classList.add("hidden");
        setVoiceOutput(
          "✓ Voice note transmitted successfully! Your message was analyzed and dispatched to my inbox.",
          "success",
        );
      } else {
        setVoiceOutput(
          `⚠️ Dispatch failed (Status ${response.status}). Please try again.`,
          "error",
        );
      }
    } catch (err) {
      setVoiceOutput(
        "❌ Connection failed. Check if the n8n container is running.",
        "error",
      );
    } finally {
      confirmSubmitBtn.disabled = false;
      confirmSubmitBtn.textContent = "Confirm & Dispatch Notification";
    }
  });

  // --- PROJECT 3: LEAD ENRICHMENT & SCORING CONTROLLER ---
  const leadForm = document.getElementById(
    "lead-form",
  ) as HTMLFormElement | null;
  const leadEmailInput = document.getElementById(
    "lead-email",
  ) as HTMLInputElement | null;
  const leadCompanyInput = document.getElementById(
    "lead-company",
  ) as HTMLInputElement | null;
  const leadSubmitBtn = document.getElementById(
    "lead-submit-btn",
  ) as HTMLButtonElement | null;
  const leadBtnText = document.getElementById("lead-btn-text");
  const statusDiv = document.getElementById("lead-status");
  const leadSkeleton = document.getElementById("lead-skeleton");
  const leadResultsCard = document.getElementById("lead-results-card");

  const leadScoreText = document.getElementById("lead-score-text");
  const leadTierBadge = document.getElementById("lead-tier-badge");
  const leadRoutingBadge = document.getElementById("lead-routing-badge");
  const leadScoreBar = document.getElementById("lead-score-bar");
  const leadCategoryText = document.getElementById("lead-category-text");
  const leadDomainText = document.getElementById("lead-domain-text");
  const leadSummaryText = document.getElementById("lead-summary-text");
  const leadIcebreakerText = document.getElementById("lead-icebreaker-text");

  // Common free/consumer email domains to enforce B2B validation
  const FREE_EMAIL_DOMAINS = [
    "gmail.com",
    "yahoo.com",
    "hotmail.com",
    "outlook.com",
    "icloud.com",
    "aol.com",
    "protonmail.com",
    "mail.com",
  ];

  function updateLeadStatus(
    message: string,
    isError: boolean = false,
    isWarning: boolean = false,
  ) {
    if (!statusDiv) return;
    statusDiv.classList.remove("hidden");
    statusDiv.textContent = message;

    if (isError) {
      statusDiv.className =
        "text-[11px] font-mono text-rose-400 p-2.5 rounded-lg border border-rose-500/30 bg-rose-950/40";
    } else if (isWarning) {
      statusDiv.className =
        "text-[11px] font-mono text-amber-400 p-2.5 rounded-lg border border-amber-500/30 bg-amber-950/40";
    } else {
      statusDiv.className =
        "text-[11px] font-mono text-emerald-400 p-2.5 rounded-lg border border-slate-800 bg-slate-900/60";
    }
  }

  leadForm?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = leadEmailInput?.value.trim().toLowerCase() || "";
    const company = leadCompanyInput?.value.trim() || "";

    if (!email) return;

    // Defensive Validation: Extract domain and check against free consumer providers
    const domain = email.split("@")[1] || "";
    if (FREE_EMAIL_DOMAINS.includes(domain)) {
      updateLeadStatus(
        "⚠️ Corporate Email Required: Please enter a work email address (e.g., name@company.com) for real-time B2B enrichment.",
        false,
        true,
      );
      return;
    }

    // Reset UI views & show skeleton loader
    statusDiv?.classList.add("hidden");
    leadResultsCard?.classList.add("hidden");
    leadSkeleton?.classList.remove("hidden");

    if (leadSubmitBtn) leadSubmitBtn.disabled = true;
    if (leadBtnText)
      leadBtnText.textContent = "Analyzing Lead via n8n & Gemini...";

    try {
      const response = await fetch(
        "https://api.genmarkangus.dev/webhook/lead-enrichment",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email,
            company: company || domain.split(".")[0],
            domain,
          }),
        },
      );

      if (!response.ok) {
        throw new Error(`n8n Webhook returned HTTP ${response.status}`);
      }

      const payload = await response.json();

      // Calculate ICP scoring variables
      const score = payload.icp_score ?? 85;
      const isTier1 = score >= 70;

      // Populate Enrichment Results Card
      if (leadScoreText) leadScoreText.textContent = `${score}%`;
      if (leadScoreBar) leadScoreBar.style.width = `${score}%`;

      if (leadTierBadge) {
        leadTierBadge.textContent = isTier1 ? "Tier 1 Lead" : "Tier 2 Lead";
        leadTierBadge.className = isTier1
          ? "px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-950 border border-emerald-500/30 text-emerald-300"
          : "px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-950 border border-amber-500/30 text-amber-300";
      }

      if (leadRoutingBadge) {
        leadRoutingBadge.textContent =
          payload.routing_status ||
          (isTier1
            ? "Priority Alert Dispatched + CRM Logged"
            : "Logged to Google Sheets");
      }

      if (leadCategoryText)
        leadCategoryText.textContent =
          payload.industry || "B2B Technology / SaaS";
      if (leadDomainText) leadDomainText.textContent = domain;
      if (leadSummaryText)
        leadSummaryText.textContent =
          payload.company_summary ||
          "Automated company profile generated successfully.";
      if (leadIcebreakerText)
        leadIcebreakerText.textContent = `"${payload.sales_icebreaker || "Looking forward to exploring how workflow automation can streamline your operations."}"`;

      // Hide Skeleton & Display Card
      leadSkeleton?.classList.add("hidden");
      leadResultsCard?.classList.remove("hidden");
      updateLeadStatus(
        "✓ Lead successfully processed & enriched by n8n!",
        false,
        false,
      );
    } catch (err) {
      leadSkeleton?.classList.add("hidden");
      updateLeadStatus(
        "❌ n8n webhook offline or unreachable on http://localhost:5678",
        true,
        false,
      );
    } finally {
      if (leadSubmitBtn) leadSubmitBtn.disabled = false;
      if (leadBtnText) leadBtnText.textContent = "Trigger Lead Workflow";
    }
  });
</script>
