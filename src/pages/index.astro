---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gen Mark Angus | AI Automation Specialist & n8n Engineer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-slate-950 text-slate-100 font-sans antialiased h-dvh overflow-hidden flex flex-col"
  >
    <!-- TOP NAVBAR -->
    <header
      class="h-14 border-b border-slate-800/80 bg-slate-950/90 backdrop-blur px-4 flex items-center justify-between z-30 shrink-0"
    >
      <div class="flex items-center gap-3">
        <button
          id="toggle-drawer"
          class="p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white hover:bg-slate-800 transition flex items-center gap-2 text-xs font-mono"
          aria-label="Toggle Drawer"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <span class="hidden sm:inline">Workflows</span>
        </button>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"
          ></span>
          <span class="font-bold text-sm tracking-tight text-white"
            >Gen Mark Angus</span
          >
          <span class="text-xs text-slate-400 font-mono hidden sm:inline-block"
            >/ AI Automation Specialist & n8n Engineer</span
          >
        </div>
      </div>

      <div class="flex items-center gap-3 font-mono text-xs">
        <span class="hidden md:inline-block text-slate-500 text-[11px]">
          n8n + Supabase + Astro
        </span>
        <a
          href="https://github.com/gen308675"
          target="_blank"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700 transition"
        >
          <span>GitHub</span>
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </a>
      </div>
    </header>

    <!-- MAIN APP CONTAINER -->
    <div
      class="relative flex-1 w-full h-[calc(100vh-3.5rem)] overflow-hidden bg-slate-950 flex flex-col"
    >
      <div
        id="drawer-overlay"
        class="fixed inset-0 z-20 bg-slate-950/60 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300"
      >
      </div>

      <!-- SIDEBAR DRAWER -->
      <aside
        id="drawer"
        class="fixed inset-y-0 left-0 z-30 w-72 bg-slate-900/95 border-r border-slate-800 flex flex-col justify-between p-4 transition-transform duration-300 ease-in-out -translate-x-full shadow-2xl"
      >
        <button
          id="close-drawer-btn"
          class="absolute top-3 right-3 text-slate-400 hover:text-teal-300 p-1.5 rounded-md hover:bg-slate-800 transition z-10"
          aria-label="Close Drawer"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <div class="space-y-6 overflow-y-auto custom-scrollbar pr-1 pt-2">
          <div>
            <div
              class="text-[10px] font-mono font-bold text-teal-400 uppercase tracking-wider mb-2 pr-6"
            >
              PRODUCTION WORKFLOWS
            </div>
            <nav class="space-y-1.5 text-xs">
              <button
                data-modal="modal-p1"
                class="w-full text-left p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 hover:border-teal-500/50 hover:bg-slate-800/80 transition group"
              >
                <div class="font-bold text-slate-200 group-hover:text-teal-300">
                  01. Neural Mirror (RAG Chat)
                </div>
                <div class="text-[11px] text-slate-400 truncate mt-0.5">
                  Supabase Vector • n8n Agent
                </div>
              </button>

              <button
                data-modal="modal-p2"
                class="w-full text-left p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 hover:border-teal-500/50 hover:bg-slate-800/80 transition group"
              >
                <div class="font-bold text-slate-200 group-hover:text-teal-300">
                  02. AI Voice Intake & Verified Dispatcher
                </div>
                <div class="text-[11px] text-slate-400 truncate mt-0.5">
                  Gemini 2.5 Flash • n8n Webhook Engine • Human-in-the-Loop •
                  Gmail API
                </div>
              </button>

              <button
                data-modal="modal-p3"
                class="w-full text-left p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 hover:border-teal-500/50 hover:bg-slate-800/80 transition group"
              >
                <div class="font-bold text-slate-200 group-hover:text-teal-300">
                  03. Autonomous Lead Enrichment & ICP Scoring
                </div>
                <div class="text-[11px] text-slate-400 truncate mt-0.5">
                  Gemini 2.5 Flash • n8n Webhook Engine • B2B Intelligence
                </div>
              </button>
            </nav>
          </div>

          <div>
            <div
              class="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider mb-2"
            >
              PROFILE & CONTACT
            </div>

            <!-- Intro Video Embed -->
            <div
              class="mb-3 rounded-xl overflow-hidden border border-slate-700/60 aspect-video w-full bg-black shadow-lg relative"
            >
              <iframe
                class="absolute inset-0 w-full h-full border-0"
                src="https://www.youtube.com/embed/4rffE0kndow?rel=0&modestbranding=1"
                title="Gen Mark Angus - Profile & Tech Stack Overview"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              >
              </iframe>
            </div>

            <nav class="space-y-1.5 text-xs">
              <button
                data-modal="modal-profile"
                class="w-full text-left p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 hover:border-teal-500/50 hover:bg-slate-800/80 transition group flex items-center gap-2"
              >
                <svg
                  class="w-4 h-4 text-slate-400 group-hover:text-teal-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  ></path>
                </svg>
                <span class="font-bold text-slate-200 group-hover:text-teal-300"
                  >Profile & Experience</span
                >
              </button>

              <button
                data-modal="modal-contact"
                class="w-full text-left p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 hover:border-teal-500/50 hover:bg-slate-800/80 transition group flex items-center gap-2"
              >
                <svg
                  class="w-4 h-4 text-slate-400 group-hover:text-teal-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
                <span class="font-bold text-slate-200 group-hover:text-teal-300"
                  >Contact Channels</span
                >
              </button>
            </nav>
          </div>
        </div>

        <div
          class="pt-4 border-t border-slate-800/80 text-[11px] text-slate-500 font-mono"
        >
          <span>Self-Hosted n8n + Docker</span>
        </div>
      </aside>

      <!-- MAIN APP CONTAINER -->
      <main
        class="flex-1 flex flex-col items-center w-full max-w-4xl mx-auto px-4 py-4 relative z-10 h-full min-h-0 overflow-hidden"
      >
        <div
          id="chat-output"
          class="w-full max-w-3xl flex-1 overflow-y-auto custom-scrollbar my-2 p-4 space-y-4 px-2 min-h-0 flex flex-col"
        >
          <div
            id="idle-hero"
            class="my-auto flex flex-col items-center text-center p-6 space-y-5 animate-fade-in"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-slate-900 border border-teal-500/30 flex items-center justify-center text-teal-400 shadow-lg shadow-teal-500/10 relative group"
            >
              <div
                class="absolute inset-0 rounded-2xl bg-teal-500/10 blur-md group-hover:bg-teal-500/20 transition"
              >
              </div>
              <svg
                class="w-8 h-8 relative z-10"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 3v3m0 12v3M3 12h3m12 0h3M5.636 5.636l2.122 2.122m8.486 8.486l2.122 2.122M5.636 18.364l2.122-2.122m8.486-8.486l2.122-2.122M12 8a4 4 0 100 8 4 4 0 000-8z"
                ></path>
              </svg>
            </div>

            <div class="space-y-2 max-w-md">
              <h1
                class="text-xl font-bold text-white tracking-tight flex items-center justify-center gap-2"
              >
                Neural Mirror Agent
                <span
                  class="text-[10px] font-mono bg-teal-950/80 text-teal-300 border border-teal-800/50 px-2 py-0.5 rounded-full font-normal"
                  >Online</span
                >
              </h1>
              <p class="text-xs text-slate-400 leading-relaxed">
                Interactively test Gen Mark’s AI workflows below, or ask
                questions directly using the chat interface.
              </p>
            </div>

            <div class="flex flex-wrap justify-center gap-2 pt-2 max-w-lg">
              <button
                type="button"
                class="chip-btn text-[11px] bg-slate-900/80 hover:bg-slate-800 border border-slate-800 hover:border-teal-500/40 text-slate-400 hover:text-teal-300 px-3.5 py-2 rounded-xl transition shadow-sm"
              >
                What n8n projects has he built?
              </button>
              <button
                type="button"
                class="chip-btn text-[11px] bg-slate-900/80 hover:bg-slate-800 border border-slate-800 hover:border-teal-500/40 text-slate-400 hover:text-teal-300 px-3.5 py-2 rounded-xl transition shadow-sm"
              >
                Explain his RAG architecture
              </button>
              <button
                type="button"
                class="chip-btn text-[11px] bg-slate-900/80 hover:bg-slate-800 border border-slate-800 hover:border-teal-500/40 text-slate-400 hover:text-teal-300 px-3.5 py-2 rounded-xl transition shadow-sm"
              >
                What is his availability for work?
              </button>
            </div>
          </div>
        </div>

        <form
          id="chat-form"
          class="w-full max-w-3xl bg-slate-900 border border-slate-800 rounded-2xl p-2 flex items-center gap-2 shadow-2xl focus-within:border-teal-500/50 transition shrink-0"
        >
          <input
            type="text"
            id="chat-input"
            placeholder="Ask away about Gen Mark's n8n projects or career..."
            class="w-full bg-transparent text-sm text-slate-100 placeholder-slate-500 px-3 py-2 focus:outline-none"
            autocomplete="off"
          />
          <button
            type="submit"
            class="bg-teal-600 hover:bg-teal-500 text-white font-semibold text-xs px-4 py-2.5 rounded-xl transition shrink-0 shadow-md flex items-center gap-1.5"
          >
            <span>Send</span>
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </form>
      </main>
    </div>
  </body>
</html>

<!-- MODAL OVERLAY BACKDROP -->
<div
  id="modal-backdrop"
  class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-200 ease-out"
>
</div>

<!-- MODAL: PROJECT 1 -->
<div
  id="modal-p1"
  class="modal-window fixed inset-0 z-50 flex items-center justify-center p-4 hidden opacity-0 scale-95 transition-all duration-200 ease-out pointer-events-none"
>
  <div
    class="bg-slate-900 border border-slate-800 rounded-2xl max-w-2xl w-full p-6 shadow-2xl pointer-events-auto flex flex-col justify-between max-h-[85vh]"
  >
    <div class="space-y-4 overflow-y-auto custom-scrollbar pr-1">
      <!-- Modal Header -->
      <div
        class="flex justify-between items-start border-b border-slate-800 pb-3"
      >
        <div>
          <span class="text-[10px] font-mono text-teal-400 uppercase font-bold"
            >WORKFLOW 01</span
          >
          <h2 class="text-lg font-bold text-white">
            Neural Mirror Agent (RAG)
          </h2>
        </div>
        <button
          type="button"
          class="close-modal text-slate-400 hover:text-white p-1">✕</button
        >
      </div>

      <!-- Description -->
      <p class="text-xs text-slate-300 leading-relaxed">
        Autonomous RAG proxy that continuously indexes knowledge vectors inside
        Supabase pgvector. Whenever a recruiter queries the system, n8n fetches
        matching context chunks and synthesizes an accurate response.
      </p>

      <!-- Video Player Container -->
      <div
        class="bg-slate-950 border border-slate-800 p-4 rounded-xl space-y-3"
      >
        <label class="block text-xs font-mono text-teal-400 font-bold">
          Architecture Walkthrough Video
        </label>

        <div
          class="relative w-full aspect-video rounded-xl overflow-hidden border border-slate-700/60 bg-black shadow-lg"
        >
          <iframe
            id="modal-p1-video"
            src="https://www.youtube.com/embed/579NnUSjCHc?rel=0&modestbranding=1"
            title="Neural Mirror Agent Walkthrough"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="absolute inset-0 w-full h-full"></iframe>
        </div>

        <p class="text-[11px] font-mono text-slate-400 text-center">
          Demonstrating Supabase pgvector embedding search & n8n execution flow.
        </p>
      </div>

      <!-- Tech Stack & Live Interactive Callout -->
      <div
        class="bg-slate-950/60 border border-slate-800 p-3 rounded-lg font-mono text-xs text-slate-400 space-y-1.5"
      >
        <div>
          <strong class="text-teal-400">Tech Stack:</strong> n8n, Supabase pgvector,
          OpenAI/Gemini Embeddings
        </div>
        <div class="text-[11px] text-slate-300">
          <strong class="text-teal-400">Live Interactive Agent:</strong> You are using
          it! Close this window and type any question directly into the main interface
          chat box behind this modal.
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="pt-4 mt-4 border-t border-slate-800 flex justify-end">
      <button
        type="button"
        class="close-modal bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 px-4 py-2 rounded-lg font-bold"
      >
        Close Window
      </button>
    </div>
  </div>
</div>

<!-- MODAL: PROJECT 2 (VOICE TRANSCRIBER) -->
<div
  id="modal-p2"
  class="modal-window fixed inset-0 z-50 flex items-center justify-center p-4 hidden opacity-0 scale-95 transition-all duration-200 ease-out pointer-events-none"
>
  <div
    class="bg-slate-900 border border-slate-800 rounded-2xl max-w-2xl w-full p-6 shadow-2xl pointer-events-auto flex flex-col justify-between max-h-[85vh]"
  >
    <div class="space-y-4 overflow-y-auto custom-scrollbar pr-1">
      <!-- Modal Header -->
      <div
        class="flex justify-between items-start border-b border-slate-800 pb-3"
      >
        <div>
          <span class="text-[10px] font-mono text-teal-400 uppercase font-bold"
            >WORKFLOW 02</span
          >
          <h2 class="text-lg font-bold text-white">
            Multimodal Voice Intake Transcriber
          </h2>
        </div>
        <button
          type="button"
          class="close-modal text-slate-400 hover:text-white p-1">✕</button
        >
      </div>

      <!-- Description -->
      <p class="text-xs text-slate-300 leading-relaxed">
        Processes .webm voice notes through Gemini 2.5 Flash for native audio
        transcription, structured entity extraction (name/email/urgency), and
        real-time frontend verification prior to Gmail dispatch.
      </p>

      <!-- Tabbed Container -->
      <div
        class="bg-slate-950 border border-slate-800 p-4 rounded-xl space-y-4"
      >
        <!-- Tab Navigation Header -->
        <div class="flex items-center gap-2 border-b border-slate-800 pb-3">
          <button
            id="tab-btn-tester"
            type="button"
            class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-semibold rounded-lg bg-teal-500/10 text-teal-400 border border-teal-500/30 transition-all"
          >
            <span>⚡</span> Live Interactive Tester
          </button>
          <button
            id="tab-btn-video"
            type="button"
            class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-medium rounded-lg text-slate-400 hover:text-slate-200 border border-transparent transition-all"
          >
            <span>▶</span> Architecture Walkthrough
          </button>
        </div>

        <!-- TAB 1: Live Interactive Tester Panel -->
        <div id="tab-content-tester" class="space-y-3">
          <label class="block text-xs font-mono text-teal-400 font-bold"
            >Interactive Audio Tester</label
          >

          <!-- Live Record Controls Container -->
          <div
            class="flex flex-col items-center justify-center p-5 bg-slate-900/60 rounded-xl border border-slate-800 space-y-3"
          >
            <button
              id="record-btn"
              type="button"
              class="relative flex items-center justify-center gap-2 px-5 py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold text-xs rounded-full transition-all shadow-lg shadow-teal-500/10 active:scale-95"
            >
              <span id="record-dot" class="w-2.5 h-2.5 rounded-full bg-white"
              ></span>
              <span id="record-btn-text">Start Recording</span>
            </button>

            <!-- Recording Status / Timer Display -->
            <div
              id="record-status"
              class="text-[11px] font-mono text-slate-400 text-center"
            >
              Please state your name and email so I can properly attribute your
              voice note.
            </div>

            <!-- Recorded Audio Preview -->
            <audio
              id="audio-preview"
              controls
              class="hidden w-full h-8 mt-2 rounded-lg"></audio>
          </div>

          <!-- Submit to n8n Webhook -->
          <button
            id="send-voice-btn"
            type="button"
            disabled
            class="w-full bg-teal-600 hover:bg-teal-500 text-white font-semibold text-xs py-2 rounded-lg transition disabled:opacity-40 disabled:cursor-not-allowed"
          >
            Process Audio Note via n8n
          </button>

          <!-- Step 2: Verification / Correction Form (Hidden initially) -->
          <div
            id="contact-confirm-card"
            class="hidden mt-3 p-4 rounded-xl border border-slate-800 bg-slate-900/90 shadow-xl space-y-3"
          >
            <div class="border-b border-slate-800 pb-2">
              <h4 class="text-xs font-bold text-slate-200">
                Verify Contact Details
              </h4>
              <p class="text-[11px] text-slate-400">
                AI transcribed your contact details. Please verify or update
                before sending.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div>
                <label class="block text-[10px] font-mono text-slate-400 mb-1"
                  >Your Name</label
                >
                <input
                  type="text"
                  id="confirm-name"
                  class="w-full px-3 py-1.5 rounded-md bg-slate-950 border border-slate-800 text-slate-200 text-xs focus:border-teal-500 focus:outline-none"
                  placeholder="e.g. Jane Doe"
                />
              </div>
              <div>
                <label class="block text-[10px] font-mono text-slate-400 mb-1"
                  >Your Email</label
                >
                <input
                  type="email"
                  id="confirm-email"
                  class="w-full px-3 py-1.5 rounded-md bg-slate-950 border border-slate-800 text-slate-200 text-xs focus:border-teal-500 focus:outline-none"
                  placeholder="e.g. jane@company.com"
                />
              </div>
            </div>

            <button
              id="confirm-submit-btn"
              type="button"
              class="w-full py-2 px-4 rounded-lg bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-xs transition"
            >
              Confirm & Dispatch Notification
            </button>
          </div>

          <!-- Dynamic Status Output Container -->
          <div
            id="voice-output"
            class="hidden text-[11px] font-mono p-3 rounded-lg border min-h-[40px] whitespace-pre-wrap transition-all duration-200"
          >
          </div>
        </div>

        <!-- TAB 2: Architecture Walkthrough Video Panel (Hidden initially) -->
        <div id="tab-content-video" class="hidden space-y-3">
          <label class="block text-xs font-mono text-teal-400 font-bold"
            >n8n Workflow Execution Demo</label
          >
          <div
            class="relative w-full aspect-video rounded-xl overflow-hidden border border-slate-700/60 bg-black shadow-lg"
          >
            <iframe
              id="walkthrough-iframe"
              src="https://www.youtube.com/embed/qcQq_wjTRIs?rel=0&modestbranding=1"
              title="AI Voice Intake Workflow Walkthrough"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="absolute inset-0 w-full h-full"></iframe>
          </div>
          <p class="text-[11px] font-mono text-slate-400 text-center">
            Recorded in OBS Studio • Demonstrating Gemini 2.5 Flash audio
            transcription & frontend verification.
          </p>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="pt-4 mt-4 border-t border-slate-800 flex justify-end">
      <button
        type="button"
        class="close-modal bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 px-4 py-2 rounded-lg font-bold"
      >
        Close Window
      </button>
